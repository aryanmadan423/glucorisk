      "source": [
        "## Export to ONNX\n",
        "\n",
        "Bundle the scaler and classifier into one pipeline for the phone to run. Set zipmap=False so the probabilities are returned as an array. The app applies calibration and the cutoff separately."
      ],
      "id": "r7hcuFPCCklC"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "YOPBtBw8CklC",
        "outputId": "2c91dab7-c420-4b19-a2d4-9f8d72403e9e"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Saved diabetes_risk_model.onnx (55,893 bytes)\n"
          ]
        }
      ],
      "source": [
        "from skl2onnx import convert_sklearn\n",
        "from skl2onnx.common.data_types import FloatTensorType\n",
        "\n",
        "export_pipeline = Pipeline([\n",
        "    (\"scaler\", scaler),\n",
        "    (\"model\", best_model),\n",
        "])\n",
        "\n",
        "initial_type = [(\"float_input\", FloatTensorType([None, len(FEATURES)]))]\n",
        "options = {id(best_model): {\"zipmap\": False}}\n",
        "onnx_model = convert_sklearn(export_pipeline, initial_types=initial_type, target_opset=15, options=options)\n",
        "\n",
        "with open(\"diabetes_risk_model.onnx\", \"wb\") as f:\n",
        "    f.write(onnx_model.SerializeToString())\n",
        "\n",
        "print(f\"Saved diabetes_risk_model.onnx ({len(onnx_model.SerializeToString()):,} bytes)\")"
      ],
      "id": "YOPBtBw8CklC"
    },
